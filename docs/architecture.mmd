%% IoT Environmental Monitoring - Data Pipeline Architecture
%% Render at https://mermaid.live or in any Markdown viewer that supports Mermaid.
flowchart TD
    subgraph SRC["1 - Data Source (Simulated Sensors)"]
        API["Open-Meteo Public API<br/>current + archive endpoints<br/>temperature / humidity /<br/>pressure / wind speed"]
    end

    subgraph COLLECT["2 - Data Collection (Python)"]
        PRE["prefill_history.py<br/>one-off historical backfill"]
        COL["collector.py<br/>automated loop every 60s<br/>request -> extract -> timestamp"]
    end

    subgraph STORE["3 - Data Storage (Time-Series)"]
        CSV[("readings.csv<br/>append-only log")]
        DB[("readings.db<br/>SQLite table")]
    end

    subgraph VIZ["4 - Visualisation Dashboard"]
        DASH["dashboard.py (Streamlit + Plotly)<br/>latest reading indicators<br/>time-series chart<br/>gauge + bar chart<br/>auto-refresh 30s"]
    end

    USER(["User / Analyst<br/>web browser"])

    API -->|HTTPS JSON| PRE
    API -->|HTTPS JSON| COL
    PRE -->|historical rows| CSV
    PRE -->|historical rows| DB
    COL -->|live rows| CSV
    COL -->|live rows| DB
    CSV -.fallback.-> DASH
    DB -->|SQL query| DASH
    DASH --> USER

    classDef src fill:#e6f2ff,stroke:#3399ff;
    classDef col fill:#e6ffe6,stroke:#33cc33;
    classDef store fill:#fff2e6,stroke:#ff9933;
    classDef viz fill:#f2e6ff,stroke:#9933ff;
    class API src;
    class PRE,COL col;
    class CSV,DB store;
    class DASH viz;
