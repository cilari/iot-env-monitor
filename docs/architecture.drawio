<mxfile host="app.diagrams.net" type="device">
  <diagram id="iot-pipeline" name="IoT Data Pipeline">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="IoT Environmental Monitoring - Data Pipeline Architecture" style="text;html=1;fontSize=16;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="120" y="20" width="600" height="30" as="geometry" />
        </mxCell>

        <mxCell id="src" value="1. DATA SOURCE (Simulated Sensors)&#10;Open-Meteo Public API (no API key)&#10;current + archive endpoints&#10;temperature | humidity | pressure | wind speed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="245" y="70" width="360" height="90" as="geometry" />
        </mxCell>

        <mxCell id="col" value="2. DATA COLLECTION (Python)&#10;prefill_history.py - one-off historical backfill&#10;collector.py - automated loop every 60s&#10;request -&gt; extract variables -&gt; timestamp -&gt; store" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="245" y="230" width="360" height="90" as="geometry" />
        </mxCell>

        <mxCell id="csv" value="readings.csv&#10;(append-only log)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="245" y="390" width="150" height="90" as="geometry" />
        </mxCell>

        <mxCell id="db" value="readings.db&#10;(SQLite table)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="455" y="390" width="150" height="90" as="geometry" />
        </mxCell>

        <mxCell id="storelbl" value="3. DATA STORAGE (Time-Series)" style="text;html=1;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="245" y="360" width="360" height="20" as="geometry" />
        </mxCell>

        <mxCell id="viz" value="4. VISUALISATION DASHBOARD&#10;dashboard.py (Streamlit + Plotly)&#10;latest-reading indicators | time-series chart&#10;gauge + bar chart | auto-refresh every 30s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="245" y="540" width="360" height="90" as="geometry" />
        </mxCell>

        <mxCell id="user" value="User / Analyst (web browser)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="315" y="700" width="220" height="50" as="geometry" />
        </mxCell>

        <mxCell id="e1" style="endArrow=block;html=1;" edge="1" parent="1" source="src" target="col">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="endArrow=block;html=1;" edge="1" parent="1" source="col" target="csv">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" style="endArrow=block;html=1;" edge="1" parent="1" source="col" target="db">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" style="endArrow=block;html=1;" edge="1" parent="1" source="db" target="viz">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" style="endArrow=block;html=1;dashed=1;" edge="1" parent="1" source="csv" target="viz">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" style="endArrow=block;html=1;" edge="1" parent="1" source="viz" target="user">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
